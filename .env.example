# Copy this file to .env and fill only the providers you use.
# Never commit the real .env file.
#
# The CLI (`openalpha ...`) loads this file automatically from the current
# working directory before any command runs, with one rule: a variable you
# have already exported in your shell always wins over the same name in
# `.env`. Docker Compose has its own, separate `.env` auto-load, keyed off
# `deploy/` (see docs/deployment/production.zh-CN.md) -- a `.env` here, at
# the repository root, is not read by `docker compose`.

# OpenAlpha CN runtime settings
OPENALPHA_RUNTIME_DIR=./runtime
OPENALPHA_WEB_DIR=
OPENALPHA_MAX_REQUEST_BYTES=33554432
OPENALPHA_HOST=127.0.0.1
OPENALPHA_PORT=8000
# Structured (JSON-lines) logging level for the openalpha_cn logger namespace.
# One of DEBUG, INFO, WARNING, ERROR, CRITICAL (V2-P0B-007).
OPENALPHA_LOG_LEVEL=INFO

# Data-provider credentials. TUSHARE_TOKEN is read when `openalpha panel build` fetches
# from Tushare, and `openalpha doctor` reports whether it is set. CHAINLIN_API_BASE_URL and
# CHAINLIN_API_KEY are read by `openalpha doctor` alone -- its credential report and `--probe`
# -- and no evidence build, panel build or REST route calls ChainLin. The AKShare adapter reads
# no credential; `doctor` is the only path that constructs it too.
# User-owned data provider credentials
TUSHARE_TOKEN=
CHAINLIN_API_BASE_URL=
CHAINLIN_API_KEY=

# Model-provider keys. Nothing under src/ reads these five, and no shipped path -- the
# CLI, the REST API, the Web workbench, the SDK's defaults -- calls a model: a key is
# read only by an OpenAICompatibleProvider that your own SDK code builds with
# api_key_env naming it.
# Optional model providers
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=
CUSTOM_MODEL_BASE_URL=
CUSTOM_MODEL_API_KEY=
