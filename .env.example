# Copy this file to .env and fill only the providers you use.
# Never commit the real .env file.
#
# The CLI (`openalpha ...`) loads this file automatically from the current
# working directory before any command runs, with one rule: a variable you
# have already exported in your shell always wins over the same name in
# `.env`. Docker Compose has its own, separate `.env` auto-load, keyed off
# `deploy/` (see docs/deployment/production.zh-CN.md) -- a `.env` here, at
# the repository root, is not read by `docker compose`.

# OpenAlpha CN runtime settings
OPENALPHA_RUNTIME_DIR=./runtime
OPENALPHA_WEB_DIR=
OPENALPHA_MAX_REQUEST_BYTES=8388608
OPENALPHA_HOST=127.0.0.1
OPENALPHA_PORT=8000
# Reserved for structured logging (V2-P0B-007). Not read by any code yet.
OPENALPHA_LOG_LEVEL=INFO

# User-owned data provider credentials
TUSHARE_TOKEN=
CHAINLIN_API_BASE_URL=
CHAINLIN_API_KEY=

# Optional model providers
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=
CUSTOM_MODEL_BASE_URL=
CUSTOM_MODEL_API_KEY=
