{
  "$defs": {
    "ArtifactDigest": {
      "additionalProperties": false,
      "description": "A named SHA-256 digest for a provider payload or other artifact.",
      "properties": {
        "name": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "name",
        "sha256"
      ],
      "title": "ArtifactDigest",
      "type": "object"
    },
    "CheckpointRecord": {
      "additionalProperties": false,
      "description": "An immutable recovery checkpoint reference.",
      "properties": {
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        },
        "state_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "State Digest",
          "type": "string"
        }
      },
      "required": [
        "name",
        "recorded_at",
        "state_digest"
      ],
      "title": "CheckpointRecord",
      "type": "object"
    },
    "VersionRef": {
      "additionalProperties": false,
      "description": "A named component version captured for reproduction.",
      "properties": {
        "component": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Component",
          "type": "string"
        },
        "version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ],
      "title": "VersionRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Everything required to reproduce and recover one research run.",
  "properties": {
    "as_of": {
      "format": "date-time",
      "title": "As Of",
      "type": "string"
    },
    "checkpoints": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CheckpointRecord"
      },
      "title": "Checkpoints",
      "type": "array"
    },
    "code_commit": {
      "maxLength": 64,
      "minLength": 7,
      "title": "Code Commit",
      "type": "string"
    },
    "config_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Config Digest",
      "type": "string"
    },
    "environment": {
      "default": [],
      "items": {
        "$ref": "#/$defs/VersionRef"
      },
      "title": "Environment",
      "type": "array"
    },
    "finished_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished At"
    },
    "mode": {
      "enum": [
        "live",
        "replay",
        "backtest"
      ],
      "title": "Mode",
      "type": "string"
    },
    "model_versions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/VersionRef"
      },
      "title": "Model Versions",
      "type": "array"
    },
    "prompt_versions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/VersionRef"
      },
      "title": "Prompt Versions",
      "type": "array"
    },
    "provider_payload_digests": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ArtifactDigest"
      },
      "title": "Provider Payload Digests",
      "type": "array"
    },
    "random_seed": {
      "title": "Random Seed",
      "type": "integer"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "run-manifest/v1",
      "default": "run-manifest/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "enum": [
        "pending",
        "running",
        "succeeded",
        "failed",
        "interrupted"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "mode",
    "as_of",
    "code_commit",
    "config_digest",
    "random_seed",
    "started_at",
    "status"
  ],
  "title": "RunManifest",
  "type": "object"
}
