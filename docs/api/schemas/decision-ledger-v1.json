{
  "$defs": {
    "AgentDecision": {
      "additionalProperties": false,
      "description": "One agent's structured contribution to a decision.",
      "properties": {
        "agent_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Agent Id",
          "type": "string"
        },
        "rationale": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "recommendation": {
          "enum": [
            "support",
            "oppose",
            "abstain"
          ],
          "title": "Recommendation",
          "type": "string"
        },
        "signal_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Signal Id",
          "type": "string"
        }
      },
      "required": [
        "agent_id",
        "signal_id",
        "recommendation",
        "rationale"
      ],
      "title": "AgentDecision",
      "type": "object"
    },
    "VersionRef": {
      "additionalProperties": false,
      "description": "A named component version captured for reproduction.",
      "properties": {
        "component": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Component",
          "type": "string"
        },
        "version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ],
      "title": "VersionRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "An immutable record intended to be appended to the decision ledger.",
  "properties": {
    "agent_outputs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/AgentDecision"
      },
      "title": "Agent Outputs",
      "type": "array"
    },
    "code_commit": {
      "maxLength": 64,
      "minLength": 7,
      "title": "Code Commit",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "decision_id": {
      "description": "Return the stable content-derived decision identifier.",
      "readOnly": true,
      "title": "Decision Id",
      "type": "string"
    },
    "evidence_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "final_action": {
      "enum": [
        "watch",
        "avoid",
        "abstain"
      ],
      "title": "Final Action",
      "type": "string"
    },
    "model_versions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/VersionRef"
      },
      "title": "Model Versions",
      "type": "array"
    },
    "prompt_versions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/VersionRef"
      },
      "title": "Prompt Versions",
      "type": "array"
    },
    "risk_decision": {
      "enum": [
        "pass",
        "reduce",
        "block"
      ],
      "title": "Risk Decision",
      "type": "string"
    },
    "routing_path": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Routing Path",
      "type": "array"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "decision-ledger/v1",
      "default": "decision-ledger/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "signal_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Signal Ids",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "created_at",
    "risk_decision",
    "final_action",
    "code_commit",
    "decision_id"
  ],
  "title": "DecisionLedger",
  "type": "object"
}
