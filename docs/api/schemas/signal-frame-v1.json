{
  "$defs": {
    "RiskFlag": {
      "description": "Every risk flag this build can attach to a signal, with what it is worth.\n\nMembers are grouped by severity, worst first, and ordered oldest-first within a group so\nthat additions read as additions. Order is not semantic: nothing sorts flags by declaration\nposition, and a signal's severity is the worst of its flags rather than the first.",
      "enum": [
        "future_data",
        "look_ahead_violation",
        "regulatory",
        "data-quality",
        "suspension",
        "redistribution_restricted",
        "redistribution_unknown",
        "source_uri_missing",
        "revised_after_initial_availability",
        "committee-disagreement"
      ],
      "title": "RiskFlag",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "An immutable, evidence-linked research conclusion or abstention.",
  "properties": {
    "abstention_reason": {
      "anyOf": [
        {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Abstention Reason"
    },
    "as_of": {
      "format": "date-time",
      "title": "As Of",
      "type": "string"
    },
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    },
    "confirmation_conditions": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Confirmation Conditions",
      "type": "array"
    },
    "direction": {
      "enum": [
        "bullish",
        "bearish",
        "neutral",
        "abstain"
      ],
      "title": "Direction",
      "type": "string"
    },
    "evidence_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "horizon": {
      "pattern": "^[1-9][0-9]{0,2}[d]$",
      "title": "Horizon",
      "type": "string"
    },
    "invalidation_conditions": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Invalidation Conditions",
      "type": "array"
    },
    "risk_flags": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RiskFlag"
      },
      "title": "Risk Flags",
      "type": "array"
    },
    "schema_version": {
      "const": "signal-frame/v1",
      "default": "signal-frame/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "signal_id": {
      "description": "Return the stable content-derived signal identifier.",
      "readOnly": true,
      "title": "Signal Id",
      "type": "string"
    },
    "strength": {
      "maximum": 1,
      "minimum": -1,
      "title": "Strength",
      "type": "number"
    },
    "subject": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Subject",
      "type": "string"
    }
  },
  "required": [
    "subject",
    "as_of",
    "direction",
    "strength",
    "confidence",
    "horizon",
    "signal_id"
  ],
  "title": "SignalFrame",
  "type": "object"
}
