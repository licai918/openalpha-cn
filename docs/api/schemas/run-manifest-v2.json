{
  "$defs": {
    "ArtifactDigest": {
      "additionalProperties": false,
      "description": "A named SHA-256 digest for a provider payload or other artifact.",
      "properties": {
        "name": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "name",
        "sha256"
      ],
      "title": "ArtifactDigest",
      "type": "object"
    },
    "CheckpointRecord": {
      "additionalProperties": false,
      "description": "An immutable recovery checkpoint reference.",
      "properties": {
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        },
        "state_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "State Digest",
          "type": "string"
        }
      },
      "required": [
        "name",
        "recorded_at",
        "state_digest"
      ],
      "title": "CheckpointRecord",
      "type": "object"
    },
    "RunMode": {
      "description": "The declared modes of one shared research cycle.\n\nMembers are ordered oldest-first rather than alphabetically, so the two `V2-P4-001`\nadditions read as additions. Order is not semantic: nothing sorts or compares modes,\nand `RunMode` deliberately does not override `__bool__` or define an ordering, because\nno mode is an \"off\" value and no mode is greater than another.",
      "enum": [
        "live",
        "replay",
        "backtest",
        "paper",
        "daily"
      ],
      "title": "RunMode",
      "type": "string"
    },
    "VersionRef": {
      "additionalProperties": false,
      "description": "A named component version captured for reproduction.",
      "properties": {
        "component": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Component",
          "type": "string"
        },
        "version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "component",
        "version"
      ],
      "title": "VersionRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Everything required to reproduce and recover one research run.",
  "properties": {
    "as_of": {
      "format": "date-time",
      "title": "As Of",
      "type": "string"
    },
    "checkpoints": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CheckpointRecord"
      },
      "title": "Checkpoints",
      "type": "array"
    },
    "code_commit": {
      "maxLength": 64,
      "minLength": 7,
      "title": "Code Commit",
      "type": "string"
    },
    "config_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Config Digest",
      "type": "string"
    },
    "environment": {
      "default": [],
      "items": {
        "$ref": "#/$defs/VersionRef"
      },
      "title": "Environment",
      "type": "array"
    },
    "finished_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished At"
    },
    "mode": {
      "$ref": "#/$defs/RunMode"
    },
    "model_versions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/VersionRef"
      },
      "title": "Model Versions",
      "type": "array"
    },
    "prompt_versions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/VersionRef"
      },
      "title": "Prompt Versions",
      "type": "array"
    },
    "provider_payload_digests": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ArtifactDigest"
      },
      "title": "Provider Payload Digests",
      "type": "array"
    },
    "random_seed": {
      "title": "Random Seed",
      "type": "integer"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "run_manifest_id": {
      "description": "Return the content address of this run's **declaration** (`V2-P4-025`).\n\n`stable_model_id` over every field except `RUN_MANIFEST_UNADDRESSED_FIELDS`, so two\nruns that declare the same inputs share an address however long they took and however\nthey ended, and two runs that declare anything different -- `config_digest` and\n`random_seed` included, which is section 9's whole point -- do not.\n\nThe split is `V2-P3-014`'s, reused: an `experiment_id` is stamped on the declaration\nand a `content_digest` on the answer, so that \"the same question, re-asked\" and \"a\ndifferent answer\" stay distinguishable. A manifest is the declaration half; the\ndecision ledger and the validation result are the answers, and they keep their own\naddresses.",
      "readOnly": true,
      "title": "Run Manifest Id",
      "type": "string"
    },
    "schema_version": {
      "const": "run-manifest/v2",
      "default": "run-manifest/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "enum": [
        "pending",
        "running",
        "succeeded",
        "failed",
        "interrupted"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "mode",
    "as_of",
    "code_commit",
    "config_digest",
    "random_seed",
    "started_at",
    "status",
    "run_manifest_id"
  ],
  "title": "RunManifest",
  "type": "object"
}
