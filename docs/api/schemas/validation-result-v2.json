{
  "$defs": {
    "AttributionTerm": {
      "additionalProperties": false,
      "description": "One additive contribution to a validated net active return.",
      "properties": {
        "category": {
          "enum": [
            "rule",
            "factor",
            "agent",
            "model"
          ],
          "title": "Category",
          "type": "string"
        },
        "contribution": {
          "title": "Contribution",
          "type": "number"
        },
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "category",
        "name",
        "contribution"
      ],
      "title": "AttributionTerm",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "An immutable outcome and attribution record.",
  "properties": {
    "attribution": {
      "items": {
        "$ref": "#/$defs/AttributionTerm"
      },
      "title": "Attribution",
      "type": "array"
    },
    "benchmark_return": {
      "title": "Benchmark Return",
      "type": "number"
    },
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    },
    "data_quality_notes": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Data Quality Notes",
      "type": "array"
    },
    "decision_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Decision Id",
      "type": "string"
    },
    "net_active_return": {
      "description": "Return realized return less benchmark return and transaction cost.",
      "readOnly": true,
      "title": "Net Active Return",
      "type": "number"
    },
    "observation_end": {
      "format": "date-time",
      "title": "Observation End",
      "type": "string"
    },
    "observation_start": {
      "format": "date-time",
      "title": "Observation Start",
      "type": "string"
    },
    "realized_return": {
      "title": "Realized Return",
      "type": "number"
    },
    "schema_version": {
      "const": "validation-result/v2",
      "default": "validation-result/v2",
      "title": "Schema Version",
      "type": "string"
    },
    "signal_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Signal Id",
      "type": "string"
    },
    "transaction_cost": {
      "minimum": 0,
      "title": "Transaction Cost",
      "type": "number"
    },
    "unexplained_return": {
      "default": 0.0,
      "title": "Unexplained Return",
      "type": "number"
    },
    "validation_id": {
      "description": "Return the stable content-derived validation identifier.",
      "readOnly": true,
      "title": "Validation Id",
      "type": "string"
    }
  },
  "required": [
    "signal_id",
    "decision_id",
    "observation_start",
    "observation_end",
    "realized_return",
    "benchmark_return",
    "transaction_cost",
    "attribution",
    "confidence",
    "net_active_return",
    "validation_id"
  ],
  "title": "ValidationResult",
  "type": "object"
}
